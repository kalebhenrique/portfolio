---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/portfolio/ProjectCard.astro";
import LanguageSwitch from "~/components/LanguageSwitch.astro";
import { ArrowLeft, ArrowUp, ExternalLink, CodeXml } from "@lucide/astro";
import { useTranslations, type Lang } from "~/i18n/ui";

export async function getStaticPaths() {
  const allProjects = await getCollection("projectsEn", ({ data }) => !data.draft);
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects },
  }));
}

const { project, allProjects } = Astro.props;
const { Content } = await render(project);

const lang: Lang = "en";
const t = useTranslations(lang);

// Other projects recommendations
const otherProjects = (allProjects || [])
  .filter((p) => p.id !== project.id)
  .slice(0, 2);

// Night theme palette
const DARK_BG_MAP: Record<string, string> = {
  "bg-azul-kaleb": "bg-[#14232E]",
  "bg-red-300": "bg-[#2B161C]",
  "bg-emerald-300": "bg-[#12271E]",
  "bg-purple-300": "bg-[#231730]",
  "bg-amber-300": "bg-[#2A2015]",
  "bg-cyan-300": "bg-[#11252D]",
};
const pageBgClass = DARK_BG_MAP[project.data.bgColor] || "bg-[#181129]";
---

<BaseLayout
  title={`${project.data.nome} — Kaleb Henrique`}
  description={project.data.description || `Project ${project.data.nome} by Kaleb Henrique`}
  showNavbar={false}
  lang={lang}
>
  <!-- Darkened background in accent hue -->
  <main class={`min-h-screen ${pageBgClass} pt-8 md:pt-14 pb-20 px-4 sm:px-6 md:px-12 lg:px-20 transition-colors duration-300`}>
    <div class="max-w-4xl mx-auto space-y-6">
      <!-- Back Navigation & Language Switcher -->
      <div class="flex items-center justify-between">
        <a
          href="/en#projetos"
          id="back-to-projects-btn"
          class="inline-flex items-center space-x-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold text-sm md:text-base transition-colors"
        >
          <ArrowLeft class="w-5 h-5" />
          <span>{t("project.back")}</span>
        </a>

        <LanguageSwitch currentLang={lang} />
      </div>

      <!-- Post card in warm reading paper style -->
      <article class="bg-[#FAF6EE] text-[#2B2520] border border-[#EADBCA] rounded-3xl p-6 sm:p-10 md:p-14 shadow-2xl space-y-8">
        <!-- Article Header -->
        <header class="space-y-4">
          <!-- Post Title -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-[#1C1714] leading-tight">
            {project.data.nome}
          </h1>

          <!-- Tags with dark outline, dark text and neutral background -->
          {project.data.tags && project.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-1">
              {project.data.tags.map((tag) => (
                <span class="px-3 py-1 rounded-lg text-xs md:text-sm font-semibold bg-[#EFE9DB] text-[#2B2520] border border-[#2B2520]">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <!-- External Links (Demo / GitHub) -->
          {(project.data.link || project.data.github) && (
            <div class="flex flex-wrap items-center gap-3 pt-2">
              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full bg-[#2B2520] hover:bg-[#403831] text-[#FAF6EE] font-bold text-sm transition-all shadow-md cursor-pointer"
                >
                  <span>{t("project.visit")}</span>
                  <ExternalLink class="w-4 h-4" />
                </a>
              )}
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full border border-[#2B2520] bg-transparent hover:bg-[#EFE9DB] text-[#2B2520] font-semibold text-sm transition-colors cursor-pointer"
                >
                  <CodeXml class="w-4 h-4" />
                  <span>{t("project.github")}</span>
                </a>
              )}
            </div>
          )}
        </header>

        <!-- Project Images (1 image or 2 images side-by-side) -->
        {project.data.src2 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 py-2">
            <div class="w-full aspect-[16/9] overflow-hidden rounded-2xl border border-[#E5D7BE] shadow-md bg-[#EDE5D3]">
              <img
                src={project.data.src}
                alt={project.data.alt || project.data.nome}
                width="1200"
                height="675"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
            <div class="w-full aspect-[16/9] overflow-hidden rounded-2xl border border-[#E5D7BE] shadow-md bg-[#EDE5D3]">
              <img
                src={project.data.src2}
                alt={project.data.alt2 || project.data.nome}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
          </div>
        ) : (
          <div class="w-full flex justify-center py-2">
            <div class="w-full aspect-[16/9] overflow-hidden rounded-2xl border border-[#E5D7BE] shadow-md bg-[#EDE5D3]">
              <img
                src={project.data.src}
                alt={project.data.alt || project.data.nome}
                width="1200"
                height="675"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
          </div>
        )}

        <!-- Markdown Post Content -->
        <div class="project-content pt-6 border-t border-[#E5D7BE]">
          <Content />
        </div>
      </article>

      <!-- Other Projects -->
      {otherProjects.length > 0 && (
        <section class="pt-10 space-y-6">
          <h2 class="text-2xl md:text-3xl font-bold text-white">
            {t("project.other")}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {otherProjects.map((p) => (
              <a
                href={`/en/projects/${p.id}`}
                class="block focus:outline-none focus:ring-2 focus:ring-[#7FC8E3] rounded-3xl group shadow-lg transition-transform duration-300 hover:scale-[1.02]"
              >
                <ProjectCard
                  tipo={p.data.tipo}
                  nome={p.data.nome}
                  src={p.data.src}
                  alt={p.data.alt}
                  bgColor={p.data.bgColor}
                  colSpan="1"
                  lang={lang}
                />
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <!-- Floating Scroll To Top Button -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label={t("project.scroll_top")}
    class="fixed bottom-6 right-6 md:bottom-10 md:right-10 z-40 w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-[#181129] border border-[#3B234B] flex items-center justify-center shadow-2xl opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:scale-110 hover:border-violeta-base focus:outline-none focus:ring-2 focus:ring-violeta-base cursor-pointer"
  >
    <ArrowUp class="w-6 h-6 text-violeta-base" />
  </button>

  <script>
    function setupProjectPage() {
      const scrollBtn = document.getElementById("scroll-to-top");

      const toggleScrollBtn = () => {
        if (window.scrollY > 250) {
          scrollBtn?.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
          scrollBtn?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
        } else {
          scrollBtn?.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
          scrollBtn?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        }
      };

      window.addEventListener("scroll", toggleScrollBtn, { passive: true });

      scrollBtn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    setupProjectPage();
  </script>
</BaseLayout>

<style is:global>
  /* Tipografia editorial confortável em papel amarelado suave */
  .project-content h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #1C1714;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .project-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1C1714;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #E5D7BE;
    line-height: 1.3;
  }

  .project-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1C1714;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .project-content h4 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1C1714;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .project-content p {
    color: #2B2520;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
  }

  .project-content ul {
    list-style-type: disc;
    padding-left: 1.75rem;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    color: #2B2520;
    line-height: 1.75;
  }

  .project-content ol {
    list-style-type: decimal;
    padding-left: 1.75rem;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    color: #2B2520;
    line-height: 1.75;
  }

  .project-content li {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .project-content strong,
  .project-content b {
    font-weight: 700;
    color: #1C1714;
  }

  .project-content a {
    color: #1d4ed8;
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .project-content a:hover {
    color: #1e3a8a;
  }

  .project-content code {
    background-color: #EDE5D3;
    color: #2B2520;
    border: 1px solid #DDD3BF;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-family: ui-monospace, monospace;
    font-size: 0.875em;
  }

  .project-content pre {
    background-color: #181129;
    color: #F9FAFB;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid #3B234B;
    overflow-x: auto;
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .project-content pre code {
    background-color: transparent;
    color: inherit;
    border: none;
    padding: 0;
  }

  .project-content blockquote {
    border-left: 4px solid #8C7A68;
    background-color: #F2ECE0;
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    color: #3F362E;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .project-content hr {
    border: none;
    border-top: 1px solid #E5D7BE;
    margin: 2rem 0;
  }
</style>
