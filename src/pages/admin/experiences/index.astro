---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getExperiences, getExperiencesRaw } from "../../../utils/cms";
import {
  Save,
  Code,
  List,
  Plus,
  Eye,
} from "@lucide/astro";

export const prerender = false;

const experiences = await getExperiences();
const rawContent = await getExperiencesRaw();
---

<AdminLayout title="Experiências Profissionais" activeNav="experiences">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-[#3B234B]">
      <div>
        <h1 class="text-3xl font-extrabold text-white">Experiências Profissionais</h1>
        <p class="text-sm text-[#B9BDEF]/80 mt-1">
          Edite o arquivo <code class="text-[#7FC8E3] bg-[#181129] px-2 py-0.5 rounded">src/content/experiences.md</code> exibido na seção Stack do site.
        </p>
      </div>

      <div class="flex items-center space-x-3 w-full sm:w-auto">
        <button
          type="button"
          id="toggle-mode-btn"
          class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl border border-[#3B234B] bg-[#242C3B] hover:bg-[#343D4F] text-sm text-gray-200 font-medium transition-colors cursor-pointer"
        >
          <Code size={16} id="mode-icon-code" />
          <List size={16} id="mode-icon-list" class="hidden" />
          <span id="mode-btn-text">Modo Markdown Bruto</span>
        </button>

        <button
          type="button"
          id="save-all-btn"
          class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-[#7FC8E3] hover:bg-[#A4E3FA] text-[#181129] text-sm font-bold transition-all shadow-lg shadow-[#7FC8E3]/15 cursor-pointer"
        >
          <Save size={16} />
          <span id="save-btn-text">Salvar Alterações</span>
        </button>
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="status-toast" class="hidden p-4 rounded-xl text-sm transition-all" role="alert"></div>

    <!-- Live Preview Box -->
    <div class="bg-[#242C3B]/60 border border-[#3B234B] rounded-3xl p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-xs uppercase tracking-wider font-semibold text-gray-400">
          <Eye size={15} class="text-[#7FC8E3]" />
          <span>Prévia em Tempo Real (Idêntica ao Frontend)</span>
        </div>
        <span class="text-xs text-[#7FC8E3] bg-[#7FC8E3]/10 px-2.5 py-0.5 rounded-full font-semibold">Ao Vivo</span>
      </div>

      <div id="live-preview-container" class="bg-[#181129] p-6 rounded-2xl border border-[#3B234B] space-y-8">
        <!-- Rendered items in JS -->
      </div>
    </div>

    <!-- VISUAL EDITOR MODE -->
    <div id="visual-editor-container" class="space-y-6">
      <div id="experiences-cards-list" class="space-y-6">
        <!-- Items generated by script -->
      </div>

      <div class="flex justify-center pt-2">
        <button
          type="button"
          id="add-experience-btn"
          class="inline-flex items-center space-x-2 px-6 py-3 rounded-2xl border-2 border-dashed border-[#7FC8E3]/40 hover:border-[#7FC8E3] bg-[#242C3B]/50 hover:bg-[#242C3B] text-sm text-[#7FC8E3] font-bold transition-all cursor-pointer"
        >
          <Plus size={18} />
          <span>Adicionar Outra Experiência</span>
        </button>
      </div>
    </div>

    <!-- RAW CODE EDITOR MODE -->
    <div id="raw-editor-container" class="hidden space-y-3">
      <div class="flex items-center justify-between text-xs text-gray-400">
        <span>Edição direta do arquivo <code class="text-white">experiences.md</code></span>
        <span>Formato YAML frontmatter</span>
      </div>
      <textarea
        id="raw-textarea"
        rows={22}
        class="w-full p-5 bg-[#181129] border border-[#3B234B] rounded-2xl text-gray-200 font-mono text-sm leading-relaxed focus:outline-hidden focus:border-[#7FC8E3] resize-y"
      >{rawContent}</textarea>
    </div>
  </div>

  <script define:vars={{ initialExperiences: experiences, initialRaw: rawContent }}>
    let currentMode = "visual"; // "visual" | "raw"
    let items = Array.isArray(initialExperiences) ? JSON.parse(JSON.stringify(initialExperiences)) : [];

    const visualContainer = document.getElementById("visual-editor-container");
    const rawContainer = document.getElementById("raw-editor-container");
    const rawTextarea = document.getElementById("raw-textarea");
    const toggleModeBtn = document.getElementById("toggle-mode-btn");
    const modeBtnText = document.getElementById("mode-btn-text");
    const modeIconCode = document.getElementById("mode-icon-code");
    const modeIconList = document.getElementById("mode-icon-list");
    const cardsList = document.getElementById("experiences-cards-list");
    const previewContainer = document.getElementById("live-preview-container");
    const addBtn = document.getElementById("add-experience-btn");
    const saveBtn = document.getElementById("save-all-btn");
    const saveBtnText = document.getElementById("save-btn-text");
    const toast = document.getElementById("status-toast");

    function showToast(message, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.className = `p-4 rounded-xl text-sm transition-all ${
        isError
          ? "bg-red-950/80 border border-red-500/50 text-red-200"
          : "bg-emerald-950/80 border border-emerald-500/50 text-emerald-200"
      }`;
      toast.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // Render Preview
    function renderPreview() {
      if (!previewContainer) return;
      if (items.length === 0) {
        previewContainer.innerHTML = '<p class="text-gray-500 text-center py-4">Nenhuma experiência cadastrada.</p>';
        return;
      }

      previewContainer.innerHTML = items
        .map(
          (item) => `
          <div class="ml-3 mt-4 flex flex-col md:flex-row md:space-x-20">
            <div>
              <p class="w-44 text-[#8E91B6]">${item.startDate || ""} — ${item.endDate || ""}</p>
            </div>
            <div>
              <h3 class="text-violeta-titulo-contraste font-semibold">
                ${item.position || "Cargo"} na
                <a
                  target="_blank"
                  rel="noreferrer"
                  href="${item.enterpriseUrl || "#"}"
                  class="inline-flex items-center hover:text-violeta-base-hover text-[#7FC8E3]"
                >
                  <span>${item.enterprise || "Empresa"}</span>
                  <span class="flex items-start ml-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                  </span>
                </a>
              </h3>
              <ul class="ml-5 mt-2 list-disc text-violeta-base text-sm md:text-base">
                ${(item.summary || []).map((s) => `<li>${s}</li>`).join("")}
              </ul>
            </div>
          </div>
        `
        )
        .join("");
    }

    // Sync current input/textarea values to the items array
    function syncInputsToItems() {
      if (!cardsList) return;
      cardsList.querySelectorAll("input, textarea").forEach((el) => {
        const idx = Number(el.getAttribute("data-index"));
        const field = el.getAttribute("data-field");
        if (!items[idx] || !field) return;
        if (field === "summary") {
          items[idx].summary = el.value
            .split("\n")
            .map((line) => line.trim())
            .filter(Boolean);
        } else {
          items[idx][field] = el.value;
        }
      });
    }

    // Move an item from one position to another
    function moveItem(fromIndex, toIndex) {
      if (toIndex < 0 || toIndex >= items.length || fromIndex === toIndex) return;
      syncInputsToItems();
      const [moved] = items.splice(fromIndex, 1);
      items.splice(toIndex, 0, moved);
      renderCards();
      renderPreview();
    }

    let draggedCardIndex = null;

    // Render Cards in Visual Editor
    function renderCards() {
      if (!cardsList) return;
      cardsList.innerHTML = "";

      items.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "bg-[#242C3B] border border-[#3B234B] rounded-3xl p-6 space-y-4 shadow-lg transition-all duration-150";
        card.setAttribute("draggable", "true");
        card.setAttribute("data-card-index", String(index));

        const bulletsText = (item.summary || []).join("\n");

        card.innerHTML = `
          <div class="flex items-center justify-between pb-3 border-b border-[#3B234B]">
            <div class="flex items-center space-x-3">
              <span class="drag-handle cursor-grab active:cursor-grabbing text-gray-500 hover:text-[#7FC8E3] p-1 rounded-md transition-colors" title="Arraste para reordenar">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="1"></circle><circle cx="9" cy="5" r="1"></circle><circle cx="9" cy="19" r="1"></circle><circle cx="15" cy="12" r="1"></circle><circle cx="15" cy="5" r="1"></circle><circle cx="15" cy="19" r="1"></circle></svg>
              </span>
              <span class="w-7 h-7 rounded-lg bg-[#3B234B] text-[#7FC8E3] flex items-center justify-center text-xs font-bold font-mono">
                #${index + 1}
              </span>
              <h3 class="font-bold text-white text-base">${item.position || "Nova Experiência"}</h3>
            </div>

            <div class="flex items-center space-x-2">
              <!-- Reorder buttons -->
              <div class="flex items-center space-x-1 bg-[#181129] p-1 rounded-xl border border-[#3B234B]">
                <button
                  type="button"
                  data-move-up="${index}"
                  ${index === 0 ? "disabled" : ""}
                  class="move-up-btn p-1.5 rounded-lg text-gray-300 hover:text-[#7FC8E3] hover:bg-[#242C3B] disabled:opacity-20 disabled:cursor-not-allowed transition-colors cursor-pointer"
                  title="Mover para cima"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
                </button>
                <button
                  type="button"
                  data-move-down="${index}"
                  ${index === items.length - 1 ? "disabled" : ""}
                  class="move-down-btn p-1.5 rounded-lg text-gray-300 hover:text-[#7FC8E3] hover:bg-[#242C3B] disabled:opacity-20 disabled:cursor-not-allowed transition-colors cursor-pointer"
                  title="Mover para baixo"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>
              </div>

              <div class="w-px h-5 bg-[#3B234B]"></div>

              <button
                type="button"
                data-delete-index="${index}"
                class="delete-card-btn p-2 text-red-400 hover:text-red-300 hover:bg-red-950/40 rounded-xl transition-colors cursor-pointer"
                title="Excluir experiência"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Cargo / Função</label>
              <input
                type="text"
                data-field="position"
                data-index="${index}"
                value="${item.position || ""}"
                placeholder="Ex: Diretor Comercial"
                class="w-full px-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm focus:outline-hidden focus:border-[#7FC8E3]"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Empresa / Organização</label>
              <input
                type="text"
                data-field="enterprise"
                data-index="${index}"
                value="${item.enterprise || ""}"
                placeholder="Ex: Empresa Júnior Struct"
                class="w-full px-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm focus:outline-hidden focus:border-[#7FC8E3]"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Link da Empresa (URL)</label>
              <input
                type="text"
                data-field="enterpriseUrl"
                data-index="${index}"
                value="${item.enterpriseUrl || ""}"
                placeholder="https://www.struct.unb.br/"
                class="w-full px-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm focus:outline-hidden focus:border-[#7FC8E3]"
              />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Início</label>
                <input
                  type="text"
                  data-field="startDate"
                  data-index="${index}"
                  value="${item.startDate || ""}"
                  placeholder="2024"
                  class="w-full px-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm focus:outline-hidden focus:border-[#7FC8E3]"
                />
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Término</label>
                <input
                  type="text"
                  data-field="endDate"
                  data-index="${index}"
                  value="${item.endDate || ""}"
                  placeholder="Presente"
                  class="w-full px-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm focus:outline-hidden focus:border-[#7FC8E3]"
                />
              </div>
            </div>

            <div class="space-y-1.5 sm:col-span-2">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">Atividades / Bullets (1 por linha)</label>
                <span class="text-xs text-gray-400">Permite tags como &lt;u&gt;texto&lt;/u&gt;</span>
              </div>
              <textarea
                data-field="summary"
                data-index="${index}"
                rows="3"
                placeholder="Liderança das equipes de comercial e projetos internos..."
                class="w-full p-3 bg-[#181129] border border-[#3B234B] rounded-xl text-white text-sm font-mono focus:outline-hidden focus:border-[#7FC8E3] resize-y"
              >${bulletsText}</textarea>
            </div>
          </div>
        `;

        // Drag & Drop events
        card.addEventListener("dragstart", (e) => {
          draggedCardIndex = index;
          syncInputsToItems();
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", String(index));
          }
          card.classList.add("opacity-40", "border-[#7FC8E3]");
        });

        card.addEventListener("dragend", () => {
          card.classList.remove("opacity-40", "border-[#7FC8E3]");
          cardsList.querySelectorAll(".card-drag-target").forEach((el) => {
            el.classList.remove("card-drag-target", "border-[#7FC8E3]", "bg-[#343D4F]/40");
          });
        });

        card.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (e.dataTransfer) {
            e.dataTransfer.dropEffect = "move";
          }
          if (draggedCardIndex !== null && draggedCardIndex !== index) {
            card.classList.add("card-drag-target", "border-[#7FC8E3]", "bg-[#343D4F]/40");
          }
        });

        card.addEventListener("dragleave", () => {
          card.classList.remove("card-drag-target", "border-[#7FC8E3]", "bg-[#343D4F]/40");
        });

        card.addEventListener("drop", (e) => {
          e.preventDefault();
          card.classList.remove("card-drag-target", "border-[#7FC8E3]", "bg-[#343D4F]/40");
          if (draggedCardIndex !== null && draggedCardIndex !== index) {
            moveItem(draggedCardIndex, index);
            draggedCardIndex = null;
          }
        });

        cardsList.appendChild(card);
      });

      // Bind input events
      cardsList.querySelectorAll("input, textarea").forEach((el) => {
        el.addEventListener("input", (e) => {
          const target = e.target;
          const idx = Number(target.getAttribute("data-index"));
          const field = target.getAttribute("data-field");
          if (field === "summary") {
            items[idx].summary = target.value
              .split("\n")
              .map((line) => line.trim())
              .filter(Boolean);
          } else {
            items[idx][field] = target.value;
          }
          renderPreview();
        });
      });

      // Bind reorder buttons events
      cardsList.querySelectorAll(".move-up-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-move-up"));
          if (idx > 0) moveItem(idx, idx - 1);
        });
      });

      cardsList.querySelectorAll(".move-down-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-move-down"));
          if (idx < items.length - 1) moveItem(idx, idx + 1);
        });
      });

      // Bind delete events
      cardsList.querySelectorAll(".delete-card-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-delete-index"));
          items.splice(idx, 1);
          renderCards();
          renderPreview();
        });
      });
    }

    // Add button
    addBtn?.addEventListener("click", () => {
      syncInputsToItems();
      items.push({
        startDate: "2024",
        endDate: "Presente",
        position: "",
        enterprise: "",
        enterpriseUrl: "https://",
        summary: ["Descrição da atividade realizada."],
      });
      renderCards();
      renderPreview();
    });

    // Toggle Mode
    toggleModeBtn?.addEventListener("click", () => {
      if (currentMode === "visual") {
        syncInputsToItems();
        currentMode = "raw";
        visualContainer?.classList.add("hidden");
        rawContainer?.classList.remove("hidden");
        modeIconCode?.classList.add("hidden");
        modeIconList?.classList.remove("hidden");
        if (modeBtnText) modeBtnText.textContent = "Modo Formulário Visual";
      } else {
        currentMode = "visual";
        rawContainer?.classList.add("hidden");
        visualContainer?.classList.remove("hidden");
        modeIconList?.classList.add("hidden");
        modeIconCode?.classList.remove("hidden");
        if (modeBtnText) modeBtnText.textContent = "Modo Markdown Bruto";
      }
    });

    // Save All
    saveBtn?.addEventListener("click", async () => {
      saveBtn.disabled = true;
      if (saveBtnText) saveBtnText.textContent = "Salvando...";

      try {
        let payload;
        if (currentMode === "raw") {
          payload = { raw: rawTextarea?.value || "" };
        } else {
          syncInputsToItems();
          payload = { experiences: items };
        }

        const res = await fetch("/api/admin/experiences", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok) {
          showToast("Arquivo experiences.md salvo com sucesso!");
          if (currentMode === "visual" && rawTextarea) {
            // Recarrega raw da API
            const getRes = await fetch("/api/admin/experiences");
            const fresh = await getRes.json();
            if (fresh.raw) rawTextarea.value = fresh.raw;
          }
        } else {
          showToast(data.error || "Erro ao salvar.", true);
        }
      } catch {
        showToast("Erro de conexão ao salvar experiências.", true);
      } finally {
        saveBtn.disabled = false;
        if (saveBtnText) saveBtnText.textContent = "Salvar Alterações";
      }
    });

    // Initial render
    renderCards();
    renderPreview();
  </script>
</AdminLayout>
