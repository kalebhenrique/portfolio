---
import { LogIn, Lock, User, ArrowLeft } from "@lucide/astro";
import "~/styles/globals.css";

export const prerender = false;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar no Painel — Kaleb Henrique</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#181129] font-poppins text-gray-200 antialiased flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-[#242C3B] border border-[#3B234B] rounded-3xl p-8 shadow-2xl relative">
      <div class="text-center mb-8">
        <a
          href="/"
          class="inline-flex items-center space-x-2 text-xs text-[#877CC4] hover:text-[#B9BDEF] mb-6 transition-colors"
        >
          <ArrowLeft size={14} />
          <span>Voltar ao Portfólio</span>
        </a>
        <h1 class="text-2xl font-bold text-[#7FC8E3]">Painel Administrativo</h1>
        <p class="text-sm text-[#B9BDEF]/80 mt-1">Gerencie os projetos exibidos no portfólio</p>
      </div>

      <div
        id="error-banner"
        class="hidden mb-6 p-3 rounded-xl bg-red-900/40 border border-red-500/50 text-red-200 text-xs"
        role="alert"
      ></div>

      <form id="login-form" class="space-y-5">
        <div>
          <label for="username" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
            Usuário
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <User size={16} />
            </span>
            <input
              type="text"
              id="username"
              name="username"
              required
              autocomplete="username"
              placeholder="admin"
              class="w-full pl-10 pr-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white placeholder-gray-500 text-sm focus:outline-none focus:border-[#7FC8E3] focus:ring-1 focus:ring-[#7FC8E3] transition-all"
            />
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
            Senha
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <Lock size={16} />
            </span>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="Sua senha"
              class="w-full pl-10 pr-4 py-2.5 bg-[#181129] border border-[#3B234B] rounded-xl text-white placeholder-gray-500 text-sm focus:outline-none focus:border-[#7FC8E3] focus:ring-1 focus:ring-[#7FC8E3] transition-all"
            />
          </div>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full mt-2 py-3 px-4 rounded-xl bg-[#7FC8E3] hover:bg-[#A4E3FA] text-[#181129] font-bold text-sm flex items-center justify-center space-x-2 transition-all shadow-lg shadow-[#7FC8E3]/10"
        >
          <LogIn size={18} />
          <span id="btn-text">Entrar no Painel</span>
        </button>
      </form>
    </div>

    <script>
      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorBanner = document.getElementById("error-banner") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const btnText = document.getElementById("btn-text") as HTMLSpanElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBanner.classList.add("hidden");
        errorBanner.textContent = "";

        const username = (document.getElementById("username") as HTMLInputElement).value.trim();
        const password = (document.getElementById("password") as HTMLInputElement).value;

        if (!username || !password) {
          errorBanner.textContent = "Por favor, preencha todos os campos.";
          errorBanner.classList.remove("hidden");
          return;
        }

        submitBtn.disabled = true;
        btnText.textContent = "Autenticando...";

        try {
          const res = await fetch("/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username, password }),
          });

          const data = await res.json();

          if (!res.ok) {
            errorBanner.textContent = data.error || "Usuário ou senha inválidos.";
            errorBanner.classList.remove("hidden");
            submitBtn.disabled = false;
            btnText.textContent = "Entrar no Painel";
            return;
          }

          window.location.href = "/admin";
        } catch {
          errorBanner.textContent = "Erro de conexão ao tentar fazer login.";
          errorBanner.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText.textContent = "Entrar no Painel";
        }
      });
    </script>
  </body>
</html>
