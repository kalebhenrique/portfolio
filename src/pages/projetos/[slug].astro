---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/portfolio/ProjectCard.astro";
import { ArrowLeft, ArrowUp, ExternalLink, CodeXml } from "@lucide/astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects", ({ data }) => !data.draft);
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects },
  }));
}

const { project, allProjects } = Astro.props;
const { Content } = await render(project);

// Outros projetos para recomendação
const otherProjects = (allProjects || [])
  .filter((p) => p.id !== project.id)
  .slice(0, 2);

// Cor de destaque do projeto para o título
const COLOR_MAP: Record<string, string> = {
  "bg-azul-kaleb": "text-azul-kaleb",
  "bg-red-300": "text-red-300",
  "bg-emerald-300": "text-emerald-300",
  "bg-purple-300": "text-purple-300",
  "bg-amber-300": "text-amber-300",
  "bg-cyan-300": "text-cyan-300",
};
const titleColorClass = COLOR_MAP[project.data.bgColor] || "text-azul-kaleb";
---

<BaseLayout
  title={`${project.data.nome} — Kaleb Henrique`}
  description={project.data.description || `Projeto ${project.data.nome} por Kaleb Henrique`}
  showNavbar={false}
>
  <main class="min-h-screen pt-12 md:pt-16 pb-20 px-6 md:px-20 lg:px-40 xl:px-60">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Navegação Voltar (no topo da página) -->
      <div>
        <a
          href="/#projetos"
          class="inline-flex items-center space-x-2 text-violeta-base hover:text-violeta-base-hover transition-colors text-sm md:text-xl font-semibold"
        >
          <ArrowLeft class="w-5 h-5" />
          <span>Voltar</span>
        </a>
      </div>

      <!-- Cabeçalho do Artigo -->
      <header class="space-y-4">
        <h1 class={`text-3xl md:text-5xl lg:text-6xl font-extrabold ${titleColorClass} leading-tight`}>
          {project.data.nome}
        </h1>

        <!-- Tags / Tecnologias (roxo padrão) -->
        {project.data.tags && project.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {project.data.tags.map((tag) => (
              <span class="px-3 py-1 rounded-lg text-xs md:text-sm font-semibold bg-[#181129] text-violeta-titulo-contraste border border-violeta-titulo-contraste">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Links Externos (Demo / GitHub) -->
        {(project.data.link || project.data.github) && (
          <div class="flex flex-wrap items-center gap-4 pt-2">
            {project.data.link && (
              <a
                href={project.data.link}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full bg-[#7FC8E3] hover:bg-[#A4E3FA] text-[#181129] font-bold text-sm transition-all shadow-md"
              >
                <span>Acessar Projeto</span>
                <ExternalLink class="w-4 h-4" />
              </a>
            )}

            {project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full bg-[#242C3B] hover:bg-[#343D4F] text-white border border-[#3B234B] font-semibold text-sm transition-colors"
              >
                <CodeXml class="w-4 h-4" />
                <span>Ver Código no GitHub</span>
              </a>
            )}
          </div>
        )}
      </header>

      <!-- Imagem do Projeto (16:9 e tamanho reduzido) -->
      <div class="w-full flex justify-center py-2">
        <div class="w-full max-w-2xl aspect-[16/9] overflow-hidden rounded-2xl border border-[#3B234B] shadow-2xl bg-[#171C25]">
          <img
            src={project.data.src}
            alt={project.data.alt || project.data.nome}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
      </div>

      <!-- Conteúdo do Post (Markdown com suporte a texto normal e destaque) -->
      <article class="prose prose-invert max-w-none font-normal text-white prose-p:font-normal prose-p:text-white prose-p:leading-relaxed prose-headings:font-bold prose-headings:text-white prose-strong:font-bold prose-strong:text-white prose-li:font-normal prose-li:text-gray-100 prose-code:font-mono prose-code:text-white prose-blockquote:font-normal prose-blockquote:text-gray-200 text-base md:text-lg leading-relaxed pt-4 border-t border-[#3B234B] space-y-4">
        <Content />
      </article>

      <!-- Outros Projetos -->
      {otherProjects.length > 0 && (
        <section class="pt-16 border-t border-[#3B234B] space-y-6">
          <h2 class="text-2xl font-bold text-white">
            Outros Projetos
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {otherProjects.map((p) => (
              <a
                href={`/projetos/${p.id}`}
                class="block focus:outline-none focus:ring-2 focus:ring-[#7FC8E3] rounded-3xl group"
              >
                <ProjectCard
                  tipo={p.data.tipo}
                  nome={p.data.nome}
                  src={p.data.src}
                  alt={p.data.alt}
                  bgColor={p.data.bgColor}
                  colSpan="1"
                />
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <!-- Botão Flutuante Voltar ao Topo (canto inferior direito) -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label="Voltar ao topo"
    class="fixed bottom-6 right-6 md:bottom-10 md:right-10 z-40 w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-[#181129] border border-[#3B234B] flex items-center justify-center shadow-2xl opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:scale-110 hover:border-violeta-base focus:outline-none focus:ring-2 focus:ring-violeta-base cursor-pointer"
  >
    <ArrowUp class="w-6 h-6 text-violeta-base" />
  </button>

  <script>
    const scrollBtn = document.getElementById("scroll-to-top");

    const toggleScrollBtn = () => {
      if (window.scrollY > 250) {
        scrollBtn?.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
        scrollBtn?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      } else {
        scrollBtn?.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
        scrollBtn?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      }
    };

    window.addEventListener("scroll", toggleScrollBtn, { passive: true });

    scrollBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  </script>
</BaseLayout>
