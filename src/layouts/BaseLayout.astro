---
import Navbar from "~/components/Navbar.astro";
import Footer from "~/components/Footer.astro";
import Chat from "~/components/chat";
import "~/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  showNavbar?: boolean;
}

const {
  title = "Kaleb H • Dev Web",
  description = "Kaleb Henrique, desenvolvedor web fullstack",
  showNavbar = true,
} = Astro.props;
---

<!doctype html>
<html lang="pt-br" class="root-scrollbar font-poppins">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <script is:inline>
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        window.addEventListener("DOMContentLoaded", () => {
          setTimeout(() => {
            document.documentElement.classList.add("smooth-scroll");
          }, 100);
        });
      }
    </script>
  </head>
  <body class="custom-scrollbar font-poppins text-sm text-violeta-base md:text-xl bg-cinza-fundo min-h-screen">
    {showNavbar && <Navbar />}
    <slot />
    <Footer />
    <Chat client:idle />
  </body>
</html>
