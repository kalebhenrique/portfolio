---
import LanguageSwitch from "./LanguageSwitch.astro";
import { useTranslations, type Lang } from "~/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const isEn = lang === "en";

const prefix = isEn ? "/en" : "";
const aboutHref = `${prefix}/#sobre`;
const stackHref = `${prefix}/#habilidades`;
const portfolioHref = `${prefix}/#projetos`;
---

<nav
  id="navbar"
  class="fixed left-0 right-0 top-0 z-20 bg-transparent backdrop-blur-md transition-colors duration-300 px-3 sm:px-8 md:px-12"
>
  <div class="relative mx-auto flex max-w-7xl items-center justify-center py-2 sm:py-3">
    <!-- Links de navegação centralizados -->
    <ul class="flex flex-row items-center justify-center gap-2 sm:gap-6 font-semibold lg:gap-10 text-xs sm:text-base md:text-xl">
      <li class="hover:text-violeta-base-hover">
        <a class="inline-flex items-center px-1.5 py-2 sm:px-2 sm:py-3" href={aboutHref}>
          {t("nav.about")}
        </a>
      </li>
      <li class="hover:text-violeta-base-hover">
        <a class="inline-flex items-center px-1.5 py-2 sm:px-2 sm:py-3" href={stackHref}>
          {t("nav.stack")}
        </a>
      </li>
      <li class="hover:text-violeta-base-hover">
        <a class="inline-flex items-center px-1.5 py-2 sm:px-2 sm:py-3" href={portfolioHref}>
          {t("nav.portfolio")}
        </a>
      </li>
      <li>
        <button
          id="navbar-chat-btn"
          type="button"
          class="rounded-full bg-violeta-base px-2.5 py-1 sm:px-4 sm:py-2 text-xs sm:text-sm md:text-xl font-semibold text-cinza-fundo hover:bg-violeta-base-hover transition-colors cursor-pointer"
        >
          {t("nav.chat")}
        </button>
      </li>
    </ul>

    <!-- Switch de idioma animado fixado no canto direito -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2">
      <LanguageSwitch currentLang={lang} />
    </div>
  </div>
</nav>

<script>
  import { toggleChat } from "~/stores/chatStore";

  function setupNavbar() {
    const navbar = document.getElementById("navbar");
    const handleScroll = () => {
      if (window.scrollY >= 140) {
        navbar?.classList.add("bg-cinza-overlay-navbar/90");
        navbar?.classList.remove("bg-transparent");
      } else {
        navbar?.classList.remove("bg-cinza-overlay-navbar/90");
        navbar?.classList.add("bg-transparent");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    document.getElementById("navbar-chat-btn")?.addEventListener("click", () => {
      toggleChat();
    });
  }

  setupNavbar();
</script>
