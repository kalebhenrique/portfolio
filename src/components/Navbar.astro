---
---

<nav
  id="navbar"
  class="fixed left-0 right-0 top-0 z-20 bg-transparent backdrop-blur-md transition-colors duration-300"
>
  <ul class="flex flex-row items-center justify-center gap-4 pb-3 pt-4 font-semibold lg:gap-12 lg:pb-4 lg:pt-5">
    <li class="hover:text-violeta-base-hover">
      <a class="inline-flex items-center px-2 py-3" href="/#sobre">Sobre</a>
    </li>
    <li class="hover:text-violeta-base-hover">
      <a class="inline-flex items-center px-2 py-3" href="/#habilidades">Stack</a>
    </li>
    <li class="hover:text-violeta-base-hover">
      <a class="inline-flex items-center px-2 py-3" href="/#projetos">Portfólio</a>
    </li>
    <li>
      <button
        id="navbar-chat-btn"
        type="button"
        class="rounded-full bg-violeta-base px-4 py-2.5 font-semibold text-cinza-fundo hover:bg-violeta-base-hover md:text-xl transition-colors cursor-pointer"
      >
        Chat
      </button>
    </li>
  </ul>
</nav>

<script>
  import { toggleChat } from "~/stores/chatStore";

  function setupNavbar() {
    const navbar = document.getElementById("navbar");
    const handleScroll = () => {
      if (window.scrollY >= 140) {
        navbar?.classList.add("bg-cinza-overlay-navbar", "bg-opacity-90");
        navbar?.classList.remove("bg-transparent");
      } else {
        navbar?.classList.remove("bg-cinza-overlay-navbar", "bg-opacity-90");
        navbar?.classList.add("bg-transparent");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    document.getElementById("navbar-chat-btn")?.addEventListener("click", () => {
      toggleChat();
    });
  }

  setupNavbar();
  document.addEventListener("astro:page-load", setupNavbar);
</script>
