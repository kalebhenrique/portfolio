---
interface Props {
  tipo: string;
  nome: string;
  src: string;
  alt: string;
  bgColor: string;
  colSpan?: "1" | "2" | string;
}

const {
  tipo,
  nome,
  src,
  alt,
  bgColor,
  colSpan = "1",
} = Astro.props;

const colSpanClass =
  colSpan === "2" || bgColor.includes("col-span-2")
    ? "md:col-span-2"
    : "";
---

<div
  class={`flex h-80 w-full flex-col rounded-3xl ${bgColor} ${colSpanClass} isolate overflow-hidden transition-transform duration-300 ease-in-out hover:scale-[1.03]`}
  style="-webkit-mask-image: -webkit-radial-gradient(white, black);"
>
  <div class="flex flex-1 flex-col items-end justify-end space-y-2 pr-6 pt-4 text-cinza-fundo">
    <h3 class="text-lg md:text-2xl font-bold">{tipo}</h3>
    <h4 class="font-medium">{nome}</h4>
  </div>
  <div class="ml-6 mt-auto flex w-full items-end justify-end transition-transform duration-300 ease-in-out group-hover:translate-y-3">
    <img
      width="600"
      height="400"
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="rounded-tl-3xl rounded-bl-none max-h-48 md:max-h-52 w-full object-cover object-left-top transition-transform duration-300 ease-in-out group-hover:scale-105"
    />
  </div>
</div>
