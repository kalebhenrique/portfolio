---
import { useTranslations, type Lang } from "~/i18n/ui";

interface Props {
  tipo: string;
  nome: string;
  src: string;
  alt: string;
  bgColor: string;
  colSpan?: "1" | "2" | string;
  lang?: Lang;
}

const {
  tipo,
  nome,
  src,
  alt,
  bgColor,
  lang = "pt",
} = Astro.props;

const t = useTranslations(lang);
const typeKey = `types.${tipo}` as any;
const displayTipo = t(typeKey) || tipo;
---

<div
  class={`flex h-80 w-full flex-col rounded-3xl ${bgColor} isolate overflow-hidden`}
  style="-webkit-mask-image: -webkit-radial-gradient(white, black);"
>
  <div class="flex flex-1 flex-col items-end justify-end space-y-2 pr-6 pt-4 text-cinza-fundo">
    <h3 class="text-lg md:text-2xl font-bold">{displayTipo}</h3>
    <h4 class="font-medium">{nome}</h4>
  </div>
  <div class="ml-6 mt-auto flex w-full items-end justify-end transition-transform duration-300 ease-in-out group-hover:translate-y-3">
    <img
      width="600"
      height="400"
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="rounded-tl-3xl rounded-bl-none max-h-48 md:max-h-52 w-full object-cover object-left-top transition-transform duration-300 ease-in-out group-hover:scale-105"
    />
  </div>
</div>
