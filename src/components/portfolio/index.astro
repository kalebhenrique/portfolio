---
import { getCollection } from "astro:content";
import FadeInWhenVisible from "../FadeInWhenVisible.astro";
import ProjectCard from "./ProjectCard.astro";
import { useTranslations, type Lang } from "~/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const isEn = lang === "en";

const projectsPt = await getCollection("projects", ({ data }) => !data.draft);
const projectsEn = await getCollection("projectsEn", ({ data }) => !data.draft);
const projects = isEn && projectsEn.length > 0 ? projectsEn : projectsPt;
projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section
  id="projetos"
  class="w-full flex flex-col items-center justify-center space-y-16 bg-cinza-fundo md:items-start md:justify-start scroll-mt-24"
>
  <FadeInWhenVisible>
    <h2 class="text-4xl text-violeta-titulo-contraste md:text-7xl font-semibold">
      {t("portfolio.title")}
    </h2>
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2} class="w-full">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 xl:gap-14 w-full">
      {projects.map((project) => {
        const isWide =
          project.data.colSpan === "2" ||
          project.data.bgColor.includes("col-span-2");
        const projectHref = isEn ? `/en/projects/${project.id}` : `/projetos/${project.id}`;

        return (
          <a
            href={projectHref}
            class={`block ${isWide ? "md:col-span-2" : ""} focus:outline-hidden focus:ring-2 focus:ring-azul-kaleb rounded-3xl group cursor-pointer transition-transform duration-300 hover:scale-[1.02]`}
            title={`${t("portfolio.open_post")} ${project.data.nome}`}
          >
            <ProjectCard
              tipo={project.data.tipo}
              nome={project.data.nome}
              src={project.data.src}
              alt={project.data.alt}
              bgColor={project.data.bgColor}
              colSpan={project.data.colSpan}
              lang={lang}
            />
          </a>
        );
      })}
    </div>
  </FadeInWhenVisible>
</section>
