---
import { getCollection } from "astro:content";
import FadeInWhenVisible from "../FadeInWhenVisible.astro";
import ProjectCard from "./ProjectCard.astro";

const projects = await getCollection("projects", ({ data }) => !data.draft);
projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section
  id="projetos"
  class="flex flex-col items-center justify-center space-y-16 bg-cinza-fundo md:items-start md:justify-start"
>
  <FadeInWhenVisible>
    <h2 class="text-4xl text-violeta-titulo-contraste md:text-7xl font-semibold">
      Portfólio
    </h2>
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2}>
    <div class="grid-col-1 grid gap-8 md:grid-cols-3 xl:gap-14 w-full">
      {projects.map((project) => {
        const isWide =
          project.data.colSpan === "2" ||
          project.data.bgColor.includes("col-span-2");
        return (
          <a
            href={`/projetos/${project.id}`}
            class={`block ${isWide ? "md:col-span-2" : ""} focus:outline-none focus:ring-2 focus:ring-azul-kaleb rounded-3xl group cursor-pointer transition-transform duration-300 hover:scale-[1.02]`}
            title={`Abrir post sobre ${project.data.nome}`}
          >
            <ProjectCard
              tipo={project.data.tipo}
              nome={project.data.nome}
              src={project.data.src}
              alt={project.data.alt}
              bgColor={project.data.bgColor}
              colSpan={project.data.colSpan}
            />
          </a>
        );
      })}
    </div>
  </FadeInWhenVisible>
</section>
