---
import FadeInWhenVisible from "../FadeInWhenVisible.astro";
import FloatingPixels from "./FloatingPixels.astro";
---

<section
  id="sobre"
  class="bg-roxo-fundo relative overflow-hidden scroll-mt-24"
>
  <FloatingPixels />

  <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:gap-16 xl:gap-24">
      <!-- Text content -->
      <div class="flex-1 space-y-8 md:space-y-10">
        <FadeInWhenVisible>
          <header>
            <h1 class="text-3xl font-semibold text-violeta-titulo sm:text-4xl md:text-5xl lg:text-7xl leading-tight">
              Eu sou um dev fullstack.
            </h1>
          </header>

          <!-- Mobile photo -->
          <div class="lg:hidden my-8 flex flex-col items-center justify-center">
            <img
              width="800"
              height="800"
              src="/eu-800.webp"
              alt="Eu, Kaleb"
              loading="lazy"
              decoding="async"
              class="w-44 h-44 sm:w-52 sm:h-52 rounded-3xl object-cover aspect-square"
            />
            <img
              src="/tape.gif"
              alt="Tape"
              width="253"
              height="100"
              class="w-40 sm:w-48 mt-4 select-none pointer-events-none"
            />
          </div>
        </FadeInWhenVisible>

        <FadeInWhenVisible delay={0.15}>
          <div class="space-y-4 text-violeta-base text-base md:text-lg leading-relaxed">
            <p>
              Estudante de Engenharia de Computação no sexto semestre na
              Universidade de Brasília e técnico em informática formado pela
              Escola Técnica de Brasília.
            </p>
            <p>
              Atuo com desenvolvimento de software de ponta a ponta e análise
              de requisitos, com foco constante em boas práticas de engenharia,
              arquitetura limpa e gerência de projetos.
            </p>
          </div>
        </FadeInWhenVisible>

        <FadeInWhenVisible delay={0.25}>
          <div class="space-y-3">
            <h2 class="text-xl md:text-2xl text-violeta-titulo font-semibold">
              Motivação e Propósito
            </h2>
            <p class="text-violeta-base text-base md:text-lg leading-relaxed">
              Busco ambientes colaborativos onde possa aprender continuamente,
              resolver problemas complexos e construir produtos que gerem
              impacto real.
            </p>
          </div>
        </FadeInWhenVisible>

        <FadeInWhenVisible delay={0.35}>
          <div class="pt-4 border-t border-violeta-titulo/15 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <p class="text-texto-suave text-sm md:text-base">
              Tem um projeto em mente ou quer trocar uma ideia?
            </p>
            <button
              id="about-chat-btn"
              type="button"
              class="inline-flex items-center justify-center rounded-full bg-azul-kaleb px-6 py-2.5 font-semibold text-roxo-fundo hover:bg-azul-kaleb-hover transition-colors text-base md:text-lg cursor-pointer shrink-0 self-start sm:self-auto"
            >
              Falar no Chat
            </button>
          </div>
        </FadeInWhenVisible>
      </div>

      <!-- Desktop photo -->
      <div class="hidden lg:flex justify-center shrink-0">
        <FadeInWhenVisible delay={0.2}>
          <div class="flex flex-col items-center">
            <img
              width="800"
              height="800"
              src="/eu-800.webp"
              alt="Eu, Kaleb"
              loading="lazy"
              decoding="async"
              class="w-64 h-64 xl:w-72 xl:h-72 rounded-3xl object-cover aspect-square"
            />
            <img
              src="/tape.gif"
              alt="Tape"
              width="253"
              height="100"
              class="w-56 xl:w-64 mt-4 select-none pointer-events-none"
            />
          </div>
        </FadeInWhenVisible>
      </div>
    </div>
</section>

<script>
  import { openChat } from "~/stores/chatStore";

  function setupAbout() {
    document.getElementById("about-chat-btn")?.addEventListener("click", () => {
      openChat();
    });
  }

  setupAbout();
  document.addEventListener("astro:page-load", setupAbout);
</script>
