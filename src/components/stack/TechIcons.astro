---

<div class="flex flex-row flex-wrap items-center justify-center gap-4 md:gap-8 lg:justify-start lg:text-start text-azul-kaleb">
  {
    technologies.map((tech) => (
      <div class="relative group flex items-center justify-center">
        <!-- Icon element with hover scaling and keyboard focus support -->
        <div
          tabindex="0"
          role="img"
          aria-label={tech.name}
          class="p-1 rounded-2xl transition-all duration-200 text-azul-kaleb hover:text-azul-kaleb-hover hover:scale-110 focus:scale-110 focus:text-azul-kaleb-hover focus:outline-hidden focus-visible:ring-2 focus-visible:ring-azul-kaleb cursor-pointer"
        >
          <svg
            viewBox={tech.viewBox}
            fill="currentColor"
            class="w-12 h-12 md:w-16 md:h-16"
            aria-hidden="true"
          >
            <path d={tech.path} />
          </svg>
        </div>

        <!-- Tooltip aligning with "Noite na montanha Celeste" design system -->
        <div
          role="tooltip"
          class="pointer-events-none absolute -top-11 left-1/2 -translate-x-1/2 z-30 opacity-0 translate-y-1.5 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:scale-100 transition-all duration-200 ease-out whitespace-nowrap"
        >
          <div class="relative px-3 py-1 rounded-lg bg-[#181129]/95 backdrop-blur-md border border-[#3B234B] shadow-2xl shadow-black/70 text-xs md:text-sm font-semibold text-violeta-base tracking-wide">
            {tech.name}
            <!-- Tooltip arrow pointing down to icon -->
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 rotate-45 bg-[#181129] border-b border-r border-[#3B234B]" />
          </div>
        </div>
      </div>
    ))
  }
</div>
