---
import FadeInWhenVisible from "../FadeInWhenVisible.astro";
import TechIcons from "./TechIcons.astro";
import WorkExperience from "./WorkExperience.astro";
import { getExperiences } from "~/utils/cms";

const experiences = await getExperiences();
---

<section
  id="habilidades"
  class="flex flex-col space-y-16 bg-cinza-fundo md:space-y-20"
>
  <FadeInWhenVisible>
    <h2 class="text-center text-4xl font-semibold text-violeta-titulo-contraste md:text-5xl lg:text-start lg:text-7xl">
      Stack & Trajetória
    </h2>
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2}>
    <TechIcons />
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2}>
    <div class="flex flex-col justify-start">
      <h2 class="text-lg text-violeta-titulo-contraste md:text-2xl font-semibold">
        Experiência Profissional
      </h2>
      <div class="space-y-11 mt-4">
        {experiences.map((item) => (
          <WorkExperience {...item} />
        ))}
      </div>
    </div>
  </FadeInWhenVisible>
</section>
