---
import FadeInWhenVisible from "../FadeInWhenVisible.astro";
import TechIcons from "./TechIcons.astro";
import WorkExperience from "./WorkExperience.astro";
import { getExperiences } from "~/utils/cms";
import { useTranslations, experiencesEn, type Lang } from "~/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);

const experiencesPt = await getExperiences();
const experiences = lang === "en" ? experiencesEn : experiencesPt;
---

<section
  id="habilidades"
  class="flex flex-col space-y-16 bg-cinza-fundo md:space-y-20 scroll-mt-24"
>
  <FadeInWhenVisible>
    <h2 class="text-center text-4xl font-semibold text-violeta-titulo-contraste md:text-5xl lg:text-start lg:text-7xl">
      {t("stack.title")}
    </h2>
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2}>
    <TechIcons />
  </FadeInWhenVisible>
  <FadeInWhenVisible delay={0.2}>
    <div class="flex flex-col justify-start">
      <h2 class="text-lg text-violeta-titulo-contraste md:text-2xl font-semibold">
        {t("stack.experience_title")}
      </h2>
      <div class="space-y-11 mt-4">
        {experiences.map((item) => (
          <WorkExperience {...item} lang={lang} />
        ))}
      </div>
    </div>
  </FadeInWhenVisible>
</section>
